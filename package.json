{
  "name": "pomodoro",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "export SDKROOT=$(xcrun --sdk macosx --show-sdk-path); expo run:ios",
    "ios:dev": "export SDKROOT=$(xcrun --sdk macosx --show-sdk-path); APP_VARIANT=dev expo prebuild --clean --platform=ios && APP_VARIANT=dev expo run:ios --device",
    "ios:test": "export SDKROOT=$(xcrun --sdk macosx --show-sdk-path); APP_VARIANT=test expo prebuild --clean --platform=ios && APP_VARIANT=test expo run:ios --device --configuration Release",
    "web": "expo start --web",
    "format": "prettier --write src",
    "test": "jest --watchAll=false --watchman=false",
    "maestro:test": "maestro test -e APP_ID=de.totap.focustimer.test .maestro",
    "format:changed": "bash -lc 'files=$(git diff --name-only --diff-filter=ACMRTUXB HEAD -- \"src\" | tr \"\\n\" \" \"); if [ -z \"$files\" ]; then echo \"No changed files in src\"; exit 0; fi; bunx prettier --write $files'",
    "test:changed": "jest --watchAll=false --watchman=false --onlyChanged",
    "extract": "lingui extract",
    "compile": "lingui compile --typescript",
    "lint": "expo lint"
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.0",
    "@expo/ui": "~56.0.18",
    "@lingui/core": "^5.9.1",
    "@lingui/react": "^5.9.1",
    "@sentry/react-native": "~7.11.0",
    "expo": "^56.0.12",
    "expo-asset": "~56.0.17",
    "expo-audio": "~56.0.12",
    "expo-build-properties": "~56.0.19",
    "expo-constants": "~56.0.18",
    "expo-dev-client": "~56.0.20",
    "expo-keep-awake": "~56.0.3",
    "expo-linking": "~56.0.14",
    "expo-localization": "~56.0.6",
    "expo-notifications": "~56.0.18",
    "expo-router": "~56.2.11",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.19",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-edge-to-edge": "^1.7.0",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-mmkv": "^4.3.0",
    "react-native-nitro-modules": "^0.35.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-unistyles": "^3.0.22",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^5.9.5",
    "@lingui/cli": "^5.9.5",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.2",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.17",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "prettier": "^3.8.4",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": ["./node_modules/react-native-gesture-handler/jestSetup.js"],
    "setupFilesAfterEnv": ["<rootDir>/src/test/setupTests.ts"],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "private": true
}
